---
// About.astro - Static component for the about section
---

<section id="about">
	<div class="about-content">
		<div class="about-text">
			<h1>Samuel Gonzalez</h1>
			<p class="identity">B.S. Computer Science · Georgia Tech · Class of May 2028</p>
			<p class="intro">
				Whether I'm building software or playing videogames,
			I center my work around competitiveness, professionalism, and collaboration.
			</p>
		</div>
		<div class="about-photos">
			<div class="photo-vertical">
				<img src="/logos/rock_climb.jpeg" alt="name" />
			</div>
		<div class="photo-wide">
			<img src="/logos/pc_build.jpeg" alt="name" />
		</div>
	</div>
	</div>
</section>

<style>
	#about {
		background: transparent;
		padding-top: clamp(4.5rem, 10vw, 8rem);
		padding-bottom: clamp(4.5rem, 9vw, 7rem);
	}

	.about-content {
		align-items: center;
		display: flex;
		gap: clamp(2rem, 5vw, 4rem);
		justify-content: space-between;
		max-width: 1080px;
	}

	.about-text {
		max-width: 620px;
	}

	#about h1 {
		font-size: clamp(2rem, 4vw, 3.15rem);
		font-weight: 650;
		letter-spacing: -0.035em;
		margin-bottom: 0.75rem;
	}

	.identity {
		color: #b9d6c5;
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
	}

	.intro {
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--text-light);
		margin-bottom: 0;
	}

	.about-photos {
		align-items: center;
		display: flex;
		flex: 0 0 auto;
		gap: 1rem;
	}

	.about-photos img {
		border-radius: 16px;
		border: 1px solid var(--border);
		display: block;
		object-fit: cover;
		width: 100%;
	}

	.photo-vertical {
		width: 220px;
	}

	.photo-vertical img {
		aspect-ratio: 3 / 4;
	}

	.photo-wide {
		width: 220px;
	}

	.photo-wide img {
		aspect-ratio: 3/4;
		object-position: center;
	}

	@media (max-width: 720px) {
		.about-content {
			flex-direction: column-reverse;
			gap: 2rem;
		}

		.about-text {
			max-width: none;
			text-align: center;
		}

		.about-photos {
	flex-direction: column;
		}

		.photo-vertical,
		.photo-wide {
			width: 200px;
		}
	}		
</style>