---
// Skills.astro
const technicalGroups = [
	{
		title: "Languages",
		skills: ["Python (Proficient)", "C++ (Proficient)", "C", "RISC-V", "Verilog"]
	},
	{
		title: "Developer Tools",
		skills: ["Unix/Linux/Git CLI", "GitHub", "GitHub Copilot", "Claude Code", "Pandas", "NumPy", "scikit-learn", "matplotlib"]
	},
	{
		title: "Observability & Data",
		skills: ["Grafana", "Prometheus", "PQL", "KQL", "Monitoring Dashboards", "Production Observability"]
	}
];

const strengths = ["Troubleshooting", "Scripting", "Servers", "Data Querying", "Incident Visibility", "Development"];
---

<section id="skills">
	<h2>Skills & Concepts</h2>
	<div class="skills-grid">
		<div class="skill-category technical-skills">
			{technicalGroups.map(group => (
				<div class="skill-group">
					<h3>{group.title}</h3>
					<div class="skill-tags">
						{group.skills.map(skill => (
							<span class="skill-tag">{skill}</span>
						))}
					</div>
				</div>
			))}
		</div>

		<div class="skill-category">
			<h3>Core Strengths</h3>
			<div class="skill-tags">
				{strengths.map(skill => (
					<span class="skill-tag">{skill}</span>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	#skills {
		background: transparent;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.9fr);
		gap: 1rem;
	}

	.skill-category {
		background: var(--surface);
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid var(--border);
	}

	.skill-group + .skill-group {
		border-top: 1px solid var(--border);
		margin-top: 1.5rem;
		padding-top: 1.5rem;
	}

	.skill-category h3 {
		color: var(--ink);
		margin-bottom: 1.5rem;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.skill-tag {
		background: var(--bg);
		color: var(--text);
		padding: 0.45rem 0.75rem;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 500;
		border: 1px solid var(--border);
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		.skills-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
