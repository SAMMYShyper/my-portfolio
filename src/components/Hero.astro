---
// Hero.astro - Static component for the hero section
---

<section id="hero">
	<div class="hero-content">
		<h1>Samuel Gonzalez</h1>
		<p class="description">Georgia Tech, Computer Science</p>
	</div>
</section>

<style>
	#hero {
		max-width: none;
		width: 100%;
		margin: 0;
		min-height: 82vh;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		background: #102720;
		color: var(--ink);
		text-align: left;
		padding: 6rem max(1.5rem, calc((100vw - 1080px) / 2));
		position: relative;
		overflow: hidden;
	}

	#hero::after {
		content: "";
		position: absolute;
		inset: auto -10vw -24vh auto;
		width: 58vw;
		height: 58vw;
		background: radial-gradient(circle, rgba(120, 175, 148, 0.18), transparent 62%);
		pointer-events: none;
	}

	.hero-content {
		max-width: 760px;
		position: relative;
		z-index: 1;
	}

	#hero h1 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		line-height: 1;
		margin-bottom: 1.25rem;
		color: var(--ink);
	}

	.description {
		font-size: 1rem;
		margin-bottom: 2.5rem;
		color: var(--text-light);
	}

	@media (max-width: 768px) {
		#hero {
			min-height: 74vh;
		}

		.description {
			font-size: 1rem;
		}
	}
</style>
