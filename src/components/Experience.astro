---
const experiences = [
	{
		organization: "Morgan Stanley",
		logo: "/logos/morgan-stanley.png",
		role: "Tech Summer Analyst — Enterprise Engineering",
		team: "E*TRADE Platform · Trading Platform Engineering & Observability",
		dates: "June 2026 — August 2026"
	},
	{
		organization: "GitHub",
		logo: "/logos/github.png",
		role: "Support Delivery Intern — Enterprise Support Engineering",
		team: "Support Delivery in Enterprise Support Engineering & Management",
		dates: "May 2025 — August 2025"
	},
	{
		organization: "Universal Aqua Technologies",
		logo: "/logos/uat.png",
		role: "Systems Engineering Intern",
		team: "Industrial Closed-Circuit Reverse Osmosis Engineering",
		dates: "May 2024 — August 2024"
	},
	{
		organization: "PlayVS College League",
		logo: "/logos/playvs.png",
		/*role: "Esports Player",*/
		role: "Competitive Fortnite Esports Player · PCL Championship Series",
		dates: "January 2026 — May 2026"
	},
	{
		organization: "Society of Hispanic Professional Engineers",
		logo: "/logos/shpe.png",
		role: "Director of Professional Development",
		dates: "August 2025 — December 2025"
	}
];

const careerExperiences = experiences.slice(0, 3);
const activities = experiences.slice(3);
---

<section id="experience">
	<div class="section-heading">
		<h2>Career</h2>
	</div>

	<div class="experience-list">
		{careerExperiences.map((experience) => (
			<article class="experience-item">
				{experience.logo && (
					<img src={experience.logo} alt="" class="org-logo" />
				)}
				<div class="experience-details">
					<h3>{experience.role}</h3>
					<p class="organization">{experience.organization}</p>
					{experience.team && <p class="team">{experience.team}</p>}
				</div>
				<p class="dates">{experience.dates}</p>
			</article>
		))}
	</div>

	<div id="activities">
		<p class="activities-label">Leadership & Activities</p>
		<div class="activities-grid">
		{activities.map((activity) => (
			<article class="activity-item">
				<div class="activity-content">
					{activity.logo && (
						<img src={activity.logo} alt="" class="org-logo" />
					)}
					<div>
						<p class="organization">{activity.organization}</p>
						<p class="activity-role">{activity.role}</p>
						{activity.team && <p class="team">{activity.team}</p>}
					</div>
				</div>
				<p class="dates">{activity.dates}</p>
			</article>
		))}
		</div>
	</div>
</section>

<style>
	#experience {
		max-width: none;
		width: 100%;
		margin: 0;
		background: var(--bg-secondary);
		padding-bottom: 3rem;
		padding-left: max(1.5rem, calc((100vw - 1080px) / 2));
		padding-right: max(1.5rem, calc((100vw - 1080px) / 2));
	}

	.section-kicker {
		color: #86c7a3;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		margin-bottom: 0.6rem;
		text-transform: uppercase;
	}

	.section-heading h2 {
		margin-bottom: 2.5rem;
	}

	.experience-list {
		border-top: 1px solid var(--border);
	}

	.experience-item {
		align-items: center;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: 1.5rem;
		padding: 1.65rem 0;
		border-bottom: 1px solid var(--border);
	}

	.dates {
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.experience-item .dates {
		text-align: right;
		white-space: nowrap;
	}

	.experience-details h3 {
		color: var(--ink);
		font-size: 1.15rem;
		line-height: 1.3;
		margin-bottom: 0.2rem;
	}

	.organization {
		color: #d7ecdf;
		font-size: 1.02rem;
		font-weight: 750;
		letter-spacing: 0.01em;
	}

	.org-logo {
		border-radius: 8px;
		flex: 0 0 auto;
		height: 100px;
		object-fit: contain;
		width: 100px;
	}

	.team {
		color: var(--text-light);
		font-size: 0.94rem;
		margin-top: 0.35rem;
	}

	#activities {
		margin-top: 2.5rem;
	}

	.activities-label {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
	}

	.activities-grid {
		border-top: 1px solid var(--border);
	}

	.activity-item {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--border);
	}

	.activity-content {
		align-items: center;
		display: flex;
		gap: 1rem;
		min-width: 0;
	}

	.activity-logo {
		height: 120px;
		width: 120px;
	}

	.activity-role {
		color: var(--text);
		font-size: 0.9rem;
		margin-top: 0.1rem;
	}

	.activity-item .organization {
		font-size: 0.92rem;
	}

	.activity-item .team {
		font-size: 0.85rem;
		margin-top: 0.15rem;
	}

	.activity-item .dates {
		flex: 0 0 auto;
		font-size: 0.78rem;
		text-align: right;
	}

	@media (max-width: 640px) {
		.experience-item {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}

		.experience-item .org-logo {
			height: 40px;
			margin-bottom: 0.25rem;
			width: 40px;
		}

		.experience-item .dates {
			text-align: left;
		}

		.activity-item {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}

		.activity-item .dates {
			text-align: left;
		}
	}
</style>